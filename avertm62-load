#!/bin/sh
# avertm62-load - reload the avertm62 module from the build directory.
# Installed root-owned in /usr/local/sbin so it can be run with sudo -n.
# Only name=integer module parameters are accepted.
#   --reset  first reset the card's PCI slot (recovers a hung TM6202 whose
#            registers all read 0xffffffff)
set -eu

# install-devtools.sh replaces @SRCDIR@ with the checkout directory
KO="@SRCDIR@/avertm62.ko"

RESET=0
if [ "${1:-}" = "--reset" ]; then
	RESET=1
	shift
fi

for arg in "$@"; do
	case "$arg" in
	*[!A-Za-z0-9_=-]*|=*|*=|-*) echo "rejected parameter: $arg" >&2; exit 2 ;;
	*=*) ;;
	*) echo "parameters must be name=value: $arg" >&2; exit 2 ;;
	esac
done

modprobe videodev
modprobe videobuf2-v4l2
modprobe videobuf2-vmalloc
modprobe i2c-dev
modprobe dvb-core
modprobe snd-pcm
rmmod avertm62 2>/dev/null || true
if [ "$RESET" = 1 ]; then
	for dev in /sys/bus/pci/devices/*; do
		[ "$(cat "$dev/vendor")" = "0x1a0a" ] || continue
		name=$(basename "$dev")
		echo "resetting $name"
		# A hung TM6202 fails the default power-state reset, so ask for a
		# secondary bus reset; if that fails, pulse the root port's
		# bus-reset bit directly and restore the card's config space.
		if ! { echo bus > "$dev/reset_method" && echo 1 > "$dev/reset"; } 2>/dev/null; then
			bridge=$(basename "$(readlink -f "$dev/..")")
			echo "bus reset via sysfs failed; pulsing bridge $bridge"
			cfg=$(mktemp)
			cp "$dev/config" "$cfg"
			ctl=$(setpci -s "$bridge" BRIDGE_CONTROL)
			setpci -s "$bridge" BRIDGE_CONTROL=$(printf '%04x' $(( 0x$ctl | 0x40 )))
			sleep 0.1
			setpci -s "$bridge" BRIDGE_CONTROL="$ctl"
			sleep 1
			dd if="$cfg" of="$dev/config" bs=64 count=1 conv=notrunc 2>/dev/null || true
			rm -f "$cfg"
		fi
		echo "after reset: $(setpci -s "$name" VENDOR_ID):$(setpci -s "$name" DEVICE_ID)"
	done
	sleep 1
fi
insmod "$KO" "$@"
dmesg | grep avertm62 | tail -n 5
